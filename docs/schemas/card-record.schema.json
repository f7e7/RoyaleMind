{
  "$defs": {
    "DataProvenance": {
      "additionalProperties": false,
      "properties": {
        "apparent_game_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apparent Game Version"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "license_status": {
          "minLength": 1,
          "title": "License Status",
          "type": "string"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "source_record_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Key"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Updated At"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_name",
        "source_url",
        "retrieved_at",
        "license_status",
        "method"
      ],
      "title": "DataProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Normalized card metadata while preserving source-specific fields.",
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "canonical_name": {
      "minLength": 1,
      "title": "Canonical Name",
      "type": "string"
    },
    "card_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Card Type"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "elixir_cost": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elixir Cost"
    },
    "evolution_level": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evolution Level"
    },
    "image_references": {
      "items": {
        "type": "string"
      },
      "title": "Image References",
      "type": "array"
    },
    "is_evolved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Is Evolved"
    },
    "key": {
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "localized_names": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Localized Names",
      "type": "object"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/DataProvenance"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "rarity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rarity"
    },
    "source_fields": {
      "additionalProperties": true,
      "title": "Source Fields",
      "type": "object"
    },
    "stable_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stable Id"
    },
    "stat_sources": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Stat Sources",
      "type": "object"
    },
    "unlock_arena": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unlock Arena"
    }
  },
  "required": [
    "key",
    "canonical_name",
    "provenance"
  ],
  "title": "CardRecord",
  "type": "object"
}
